# ============================================================================
# 环境变量模板 — 博客后端服务
# ============================================================================
#
# 【使用方法】
#   复制为 .env 文件后修改：
#     cp deploy/.env.example deploy/.env
#   然后编辑 deploy/.env 填入实际值。
#
# 【安全提醒】
#   .env 文件包含密码和密钥，绝对不能提交到 Git！
#   项目根目录的 .gitignore 已经排除了 .env 文件。
#
# ============================================================================

# ── 数据库 ────────────────────────────────────────────────────────────
# PostgreSQL 连接字符串格式：
#   postgresql://用户名:密码@主机:端口/数据库名?参数
#
# blog-db 是 docker-compose.yml 中数据库服务的容器名，
# Docker Compose 自动创建内部 DNS，让服务之间通过容器名互相访问。
# 所以后端容器内可以用 blog-db 作为主机名连接数据库，
# 而不需要知道数据库容器的 IP 地址。
POSTGRES_PASSWORD=<替换为一个强密码>
DATABASE_URL=postgresql://blog:${POSTGRES_PASSWORD}@blog-db:5432/blog

# ── 认证 ──────────────────────────────────────────────────────────────
# JWT (JSON Web Token) 密钥，用于签名和验证用户登录 token。
# 必须是一个随机的、足够长的字符串（建议 32 位以上）。
# 生成方法：openssl rand -base64 32
JWT_SECRET=<替换为 openssl rand -base64 32 的输出>
JWT_EXPIRES_IN=7d

# ── 服务 ──────────────────────────────────────────────────────────────
# 后端服务监听的端口（需要与 docker-compose.yml 中的 ports 映射一致）
PORT=4000

# WebSocket 最大并发连接数（AI 聊天流式响应使用 WebSocket）
MAX_WS_CONNECTIONS=100

# 每个 topic 每天允许生成的文章数量上限（防止滥用）
ARTICLE_THROTTLE_PER_TOPIC_PER_DAY=200

# ── 跨域 ──────────────────────────────────────────────────────────────
# 允许访问 API 的前端域名。
# 后端的 CORS 中间件会检查请求的 Origin 头是否在此列表中。
# 多个域名用逗号分隔（如 https://blog.example.com,https://admin.example.com）
CORS_ORIGIN=https://your-domain.com

# ── LLM / AI 聊天（可选）────────────────────────────────────────────
# 如果不配置，AI 聊天功能会提示"无可用模型"。
# LLM_PROVIDER=openai-compatible
# LLM_API_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=gpt-4o-mini
