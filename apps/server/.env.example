# ============================================================================
# 环境变量模板 — 博客后端服务（Docker Compose 部署）
# ============================================================================
#
# 【使用方法】
#   复制为 .env 文件后修改：
#     cp deploy/.env.example deploy/.env
#   然后编辑 deploy/.env 填入实际值。
#
# 【安全提醒】
#   .env 文件包含密码和密钥，绝对不能提交到 Git！
#   项目根目录的 .gitignore 已经排除了 .env 文件。
#
# ============================================================================


# ── 数据库 ────────────────────────────────────────────────────────────────
# PostgreSQL 密码，同时被 docker-compose 的 db 服务和 DATABASE_URL 引用。
# 生成方法：openssl rand -base64 24
POSTGRES_PASSWORD=<替换为一个强密码>

# PostgreSQL 连接字符串。
# blog-db 是 docker-compose.yml 中数据库服务的容器名，
# Docker Compose 内部 DNS 会自动解析。
DATABASE_URL=postgresql://blog:${POSTGRES_PASSWORD}@blog-db:5432/blog


# ── 认证 ──────────────────────────────────────────────────────────────────
# JWT 签名密钥，必须是随机的长字符串（建议 32 位以上）。
# 生成方法：openssl rand -base64 32
JWT_SECRET=<替换为 openssl rand -base64 32 的输出>

# Token 过期时间（默认 7d）
JWT_EXPIRES_IN=7d


# ── 服务 ──────────────────────────────────────────────────────────────────
# 后端监听端口（需与 docker-compose.yml 中 ports 映射一致）
PORT=4000

# 运行环境：production | development
NODE_ENV=production

# WebSocket 最大并发连接数（AI 聊天流式响应使用 WebSocket）
MAX_WS_CONNECTIONS=100


# ── 跨域 ──────────────────────────────────────────────────────────────────
# 允许访问 API 的前端域名。
# 多个域名用逗号分隔，如 https://blog.example.com,https://admin.example.com
CORS_ORIGIN=https://your-domain.com


# ── 日志 ──────────────────────────────────────────────────────────────────
# 日志级别：trace | debug | info | warn | error | fatal
# 生产环境默认 info，开发环境默认 debug
# LOG_LEVEL=info


# ── LLM / AI 聊天 ────────────────────────────────────────────────────────
# 提供者类型：openai-compatible | ollama
# 如果不设置，会根据已配置的环境变量自动检测。
# 如果不配置任何 LLM 变量，AI 功能会提示"无可用模型"，其他功能正常。
# LLM_PROVIDER=openai-compatible

# ── 方案 A：OpenAI 兼容 API（推荐云端部署使用）──────────────────────────
# 兼容 OpenAI、DeepSeek、SiliconFlow、Groq、Together AI 等。
# LLM_API_KEY=sk-xxxx
# LLM_API_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ── 方案 B：Ollama（本地 / 自托管）───────────────────────────────────────
# 仅当服务器上运行了 Ollama 实例且后端容器能访问时有效。
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_TEMPERATURE=0.7


# ── 文章自动生成 ──────────────────────────────────────────────────────────
# 每个 topic 每天允许生成的文章数量上限（防止滥用）
ARTICLE_THROTTLE_PER_TOPIC_PER_DAY=200

# 生成文章的固定作者邮箱（需为已注册用户）。不设置则按调用者身份。
# ARTICLE_AUTHOR_EMAIL=admin@example.com

# ── 定时生成（可选）──────────────────────────────────────────────────────
# 是否启用定时自动生成文章
# ARTICLE_CRON_ENABLED=false

# 生成计划，格式：topic:sub1|sub2;topic2:subA|subB
# ARTICLE_CRON_PLANS=react:fiber|hooks;webpack:tree-shaking|module-federation

# 生成间隔（分钟），默认 1440（每天一次）
# ARTICLE_CRON_INTERVAL_MINUTES=1440

# 每个子主题每次生成的文章数量
# ARTICLE_CRON_COUNT_PER_SUBTOPIC=1

# 文章字数范围
# ARTICLE_CRON_MIN_WORDS=1200
# ARTICLE_CRON_MAX_WORDS=2500

# 并发生成数量
# ARTICLE_CRON_CONCURRENCY=1

# 单篇文章最大重试次数
# ARTICLE_CRON_MAX_RETRIES=2

# 生成后是否自动发布（false 则保存为草稿）
# ARTICLE_CRON_AUTO_PUBLISH=true
