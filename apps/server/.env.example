# Database
DATABASE_URL="postgresql://user:password@localhost:5432/blog?schema=public"

# JWT (use a long random string in production)
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Logging (optional): trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

# Ollama article generation
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen2.5:14b"
OLLAMA_MODEL="qwen3:32b-q4_K_M"
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TEMPERATURE=0.7

# Optional: fixed author for generated posts
# ARTICLE_AUTHOR_EMAIL="admin@example.com"

# Optional: prevent generating too many posts per topic per day
# ARTICLE_THROTTLE_PER_TOPIC_PER_DAY=20

# Scheduler (phase 3)
ARTICLE_CRON_ENABLED=false
# format: topic:sub1|sub2;topic2:subA|subB
ARTICLE_CRON_PLANS="react:fiber|hooks;webpack:tree-shaking|module-federation"
ARTICLE_CRON_INTERVAL_MINUTES=1440
ARTICLE_CRON_COUNT_PER_SUBTOPIC=1
ARTICLE_CRON_MIN_WORDS=1200
ARTICLE_CRON_MAX_WORDS=2500
ARTICLE_CRON_CONCURRENCY=1
ARTICLE_CRON_MAX_RETRIES=2
ARTICLE_CRON_AUTO_PUBLISH=true
