# Database
DATABASE_URL=postgresql+psycopg://blog:YOUR_PASSWORD@localhost:5432/blog

# Server
PORT=YOUR_PORT_NUMBER

# Tavily Web Search (enables LLM web search via Function Calling)
TAVILY_API_KEY="your_tavily_api_key"

# arxiv
ARXIV_CATEGORIES="cs.AI,cs.LG"
ARXIV_MAX_RESULTS=3
ARXIV_DELAY_SECONDS=10.0
ARXIV_NUM_RETRIES=2
ARXIV_CACHE_ENABLED=true

# llm
LLM_API_KEY="your_llm_api_key"
LLM_API_BASE_URL="your_llm_api_base_url"
LLM_MODEL="your_llm_model"
LLM_TEMPERATURE=0.3
QUALITY_MIN_SCORE=7

# langfuse
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_PUBLIC_KEY="your_langfuse_public_key"
LANGFUSE_SECRET_KEY="your_langfuse_secret_key"

# Scheduler (APScheduler)
SCHEDULER_ENABLED=false
SCHEDULER_CRON_HOUR=6
SCHEDULER_CRON_MINUTE=0
SCHEDULER_TIMEZONE="Asia/Shanghai"
TAVILY_DAILY_QUERY="AI LLM agent news this week"