{
  "name": "blog-fullstack",
  "private": true,
  "version": "1.0.0",
  "author": "Jack",
  "description": "A full-stack blog system built with React, Node.js, GraphQL, and PostgreSQL.",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:client": "pnpm --filter @blog-fullstack/client dev",
    "dev:server": "pnpm --filter @blog-fullstack/server dev",
    "batch:generate": "pnpm --filter @blog-fullstack/server batch:generate",
    "codegen": "pnpm -r codegen",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r exec rm -rf node_modules dist build",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "keywords": [
    "blog",
    "fullstack",
    "react",
    "nodejs",
    "graphql",
    "postgresql"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  }
}
