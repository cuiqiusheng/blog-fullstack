{
  "name": "blog-fullstack",
  "private": true,
  "version": "1.0.0",
  "author": "Jack",
  "description": "A full-stack blog system built with React, Node.js, GraphQL, and PostgreSQL.",
  "scripts": {
    "dev": "pnpm -r dev",
    "dev:client": "pnpm --filter @blog-fullstack/client dev",
    "dev:server": "pnpm --filter @blog-fullstack/server dev",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "format": "prettier --write .",
    "clean": "pnpm -r exec rm -rf node_modules dist build"
  },
  "keywords": [
    "blog",
    "fullstack",
    "react",
    "nodejs",
    "graphql",
    "postgresql"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "prettier": "^3.8.1"
  }
}
